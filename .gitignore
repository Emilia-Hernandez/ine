# El despliegue distribuye únicamente el release aprobado vigente. Los
# históricos permanecen locales y no se incorporan por accidente a Render.
dashboard/data/releases/*
!dashboard/data/releases/radar27-dashboard-security.5/
dashboard/assets/releases/*
!dashboard/assets/releases/radar27-dashboard-security.5/

# Los datos oficiales y las ejecuciones auditadas se regeneran mediante los notebooks.
data/raw/
data/interim/
artifacts/

# Copia local redundante; el notebook 00 descarga y conserva la versión bajo data/raw/reference/.
Manual-Conteos-Censales-2009-2024.pdf
